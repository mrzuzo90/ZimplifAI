# ─────────────────────────────────────────────
# ZimplifAI — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# ─────────────────────────────────────────────

# Resend — obligatorio para que el formulario de contacto envíe emails.
# Crea una clave en https://resend.com/api-keys (plan free).
RESEND_API_KEY=

# Email que recibe los mensajes del formulario de contacto (tu email real).
CONTACT_EMAIL=

# Remitente de los emails. Usa un dominio verificado en Resend.
# Mientras no verifiques dominio, Resend permite: "ZimplifAI <onboarding@resend.dev>"
RESEND_FROM="ZimplifAI <onboarding@resend.dev>"

# Email público que se muestra en la web (sección contacto y footer).
NEXT_PUBLIC_CONTACT_EMAIL=contacto@zuzo.es

# URL pública de producción (para OG y sitemap).
# Vercel inyecta VERCEL_URL automáticamente; esto es el fallback.
NEXT_PUBLIC_SITE_URL=https://zimplifai.vercel.app

# Analytics de Vercel, opt-in. Pon "true" para habilitarlo (pide consentimiento al visitante).
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# WhatsApp para el botón de contacto directo (código de país + número, sin +, sin espacios).
# Ej: "34600111222". Vacío = se oculta el botón.
NEXT_PUBLIC_WHATSAPP=

# Redes sociales mostradas en contacto/footer. Vacío = se ocultan.
NEXT_PUBLIC_GITHUB=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
